          "id": "736c71981afc41ce9dbe7ca0151d4fde",
          "name": "spam",
          "filename": "D:\\coding\\QCODES\\RETempGUI\\RETempGUI\\RETempGUI\\labremote\\workflow\\spam.py",
          "source": "\"\"\"EA then EC SPAM; uses both chamber settings snapshots and external MW sources.\"\"\"\nfrom pathlib import Path\nfrom labremote.characterization import pulse_experiment\nfrom labremote.runtime.workflow_result import WorkflowResult\n\ndef main(devices):\n    p=devices.parameters\n    settings={ch:pulse_experiment.validate('spam',p['settings'][ch]) for ch in ('EA','EC')}\n    if any(settings[ch]['chamber']!=ch for ch in settings):raise ValueError('SPAM chamber/settings mismatch')\n    fpga=devices.fpga(p.get('fpga','fpga_local'));reports={};paths=[]\n    for ch in ('EA','EC'):\n        devices.wait(0)\n        folder=str(Path(devices.run_directory)/ch) if devices.run_directory else p.get('directory')\n        report=fpga.run_spam(ch,settings=settings[ch],directory=folder,frequency_hz=p.get('frequency_hz',{}).get(ch)).wait()\n        reports[ch]=report\n        if isinstance(report,dict) and report.get('folder'):paths.append(report['folder'])\n        if not isinstance(report,dict) or report.get('status')!='completed':\n            return WorkflowResult(status='cancelled' if isinstance(report,dict) and report.get('status')=='cancelled' else 'failed',\n                reason=ch+' SPAM did not complete',continue_allowed=False,result_paths=paths,value=reports)\n    return WorkflowResult(result_paths=paths,value=reports)\n",
